+/* ---- synchronous SCK helpers (dispatch_async to avoid XPC deadlocks) ---- */
+
+API_AVAILABLE(macos(12.3))
+static SCShareableContent* avf_get_shareable_content_sync(AVFormatContext *s, int include_windows)
+{
+    __block SCShareableContent* result = nil;
+    __block NSError* blockError = nil;
+    dispatch_semaphore_t sem = dispatch_semaphore_create(0);
+
+    BOOL excludeDesktopWindows = include_windows ? NO : YES;
+    dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
+        [SCShareableContent getShareableContentExcludingDesktopWindows:excludeDesktopWindows
+                                                 onScreenWindowsOnly:YES
+                                                    completionHandler:^(SCShareableContent *content, NSError *error) {
+            result = [content retain];
+            blockError = [error retain];
+            dispatch_semaphore_signal(sem);
+        }];
+    });
+
+    dispatch_time_t timeout = dispatch_time(DISPATCH_TIME_NOW, 5LL * NSEC_PER_SEC);
+    if (dispatch_semaphore_wait(sem, timeout) != 0) {
+        av_log(s, AV_LOG_ERROR, "ScreenCaptureKit: getShareableContent timed out after 5s\n");
+        return nil;
+    }
+
+    if (blockError) {
+        av_log(s, AV_LOG_ERROR, "ScreenCaptureKit: failed to get shareable content: %s\n",
+               [[blockError localizedDescription] UTF8String]);
+        [blockError release];
+        [result release];
+        return nil;
+    }
+    return [result autorelease];
+}
+
+API_AVAILABLE(macos(12.3))
+static void avf_sck_stop_capture_sync(SCStream *stream)
+{
+    dispatch_semaphore_t sem = dispatch_semaphore_create(0);
+
+    dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
+        [stream stopCaptureWithCompletionHandler:^(NSError *error) {
+            (void)error;
+            dispatch_semaphore_signal(sem);
+        }];
+    });
+
+    dispatch_time_t timeout = dispatch_time(DISPATCH_TIME_NOW, 3LL * NSEC_PER_SEC);
+    if (dispatch_semaphore_wait(sem, timeout) != 0) {
+        av_log(NULL, AV_LOG_WARNING, "ScreenCaptureKit: stopCapture timed out after 3s\n");
+    }
+}
+
+API_AVAILABLE(macos(12.3))
+static int avf_sck_start_capture_sync(AVFormatContext *s, SCStream *stream)
+{
+    __block NSError* blockError = nil;
+    dispatch_semaphore_t sem = dispatch_semaphore_create(0);
+
+    dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
+        [stream startCaptureWithCompletionHandler:^(NSError *error) {
+            blockError = [error retain];
+            dispatch_semaphore_signal(sem);
+        }];
+    });
+
+    dispatch_time_t timeout = dispatch_time(DISPATCH_TIME_NOW, 5LL * NSEC_PER_SEC);
+    if (dispatch_semaphore_wait(sem, timeout) != 0) {
+        av_log(s, AV_LOG_ERROR, "ScreenCaptureKit: startCapture timed out after 5s\n");
+        // Must stop before releasing to avoid ghost streams
+        avf_sck_stop_capture_sync(stream);
+        return AVERROR(ETIMEDOUT);
+    }
+
+    if (blockError) {
+        av_log(s, AV_LOG_ERROR, "ScreenCaptureKit: failed to start capture: %s\n",
+               [[blockError localizedDescription] UTF8String]);
+        [blockError release];
+        return AVERROR_EXTERNAL;
+    }
+    return 0;
+}
+
+/* ---- SCK screen capture setup ---- */
+
+API_AVAILABLE(macos(12.3))
+static int avf_setup_sck_screen_capture(AVFormatContext *s, int screen_index)
+{
+    AVFContext *ctx = (AVFContext*)s->priv_data;
+    int need_windows = ctx->capture_window_id > 0;
+
+    // 1. Get shareable content
+    SCShareableContent *shareableContent = avf_get_shareable_content_sync(s, need_windows);
+    if (!shareableContent) return AVERROR_EXTERNAL;
+
+    SCContentFilter *filter = nil;
+    int captureWidth  = 0;
+    int captureHeight = 0;
+
+    if (need_windows) {
+        // Window capture requires a window server connection.
+        // CLI processes don't have one by default, so ensure NSApplication
+        // is initialized as an accessory (no dock icon, no menu bar).
+        [NSApplication sharedApplication];
+        [NSApp setActivationPolicy:NSApplicationActivationPolicyAccessory];
+
+        // Window capture mode
+        NSArray<SCWindow*> *windows = shareableContent.windows;
+        SCWindow *targetWindow = nil;
+        for (SCWindow *w in windows) {
+            if ((int)w.windowID == ctx->capture_window_id) {
+                targetWindow = w;
+                break;
+            }
+        }
+        if (!targetWindow) {
+            av_log(s, AV_LOG_ERROR, "ScreenCaptureKit: window ID %d not found\n",
+                   ctx->capture_window_id);
+            return AVERROR(EINVAL);
+        }
+
+        filter = [[SCContentFilter alloc] initWithDesktopIndependentWindow:targetWindow];
+        CGRect frame = targetWindow.frame;
+        captureWidth  = ctx->width > 0  ? ctx->width  : (int)frame.size.width;
+        captureHeight = ctx->height > 0 ? ctx->height : (int)frame.size.height;
+
+        av_log(s, AV_LOG_INFO, "ScreenCaptureKit: targeting window ID %d (%s)\n",
+               ctx->capture_window_id,
+               targetWindow.title ? [targetWindow.title UTF8String] : "untitled");
+    } else {
+        // Display capture mode
+        NSArray<SCDisplay*> *displays = shareableContent.displays;
+        if (screen_index < 0 || screen_index >= (int)displays.count) {
+            av_log(s, AV_LOG_ERROR, "ScreenCaptureKit: display index %d out of range (0-%lu)\n",
+                   screen_index, (unsigned long)(displays.count - 1));
+            return AVERROR(EINVAL);
+        }
+
+        SCDisplay *display = displays[screen_index];
+        filter = [[SCContentFilter alloc] initWithDisplay:display excludingWindows:@[]];
+        captureWidth  = ctx->width > 0  ? ctx->width  : (int)display.width;
+        captureHeight = ctx->height > 0 ? ctx->height : (int)display.height;
+    }
+
+    // 2. Configure
+    SCStreamConfiguration *config = [[SCStreamConfiguration alloc] init];
+    config.width  = captureWidth;
+    config.height = captureHeight;
+
+    if (ctx->framerate.num > 0)
+        config.minimumFrameInterval = CMTimeMake(ctx->framerate.den, ctx->framerate.num);
+
+    config.showsCursor = ctx->capture_cursor ? YES : NO;
+
+    // Mouse clicks (macOS 15.0+)
+    if (ctx->capture_mouse_clicks) {
+        if (__builtin_available(macOS 15.0, *)) {
+            config.showMouseClicks = YES;
+        } else {
+            av_log(s, AV_LOG_WARNING,
+                   "ScreenCaptureKit: showMouseClicks requires macOS 15.0+, ignoring\n");
+        }
+    }
+
+    // Pixel format: map AVPixelFormat → CVPixelFormatType via avf_pixel_formats[]
+    // SCStreamConfiguration only supports: BGRA, l10r, 420v, 420f
+    // (see Apple docs: SCStreamConfiguration.pixelFormat)
+    static const OSType sck_supported_formats[] = {
+        kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange,  // 420v (NV12) — preferred, encoder-compatible
+        kCVPixelFormatType_420YpCbCr8BiPlanarFullRange,    // 420f
+        kCVPixelFormatType_32BGRA,                         // BGRA
+        kCVPixelFormatType_64RGBAHalf,                     // l10r
+        0
+    };
+
+    OSType pixelType = 0;
+    struct AVFPixelFormatSpec pxl_fmt_spec = { AV_PIX_FMT_NONE, 0 };
+    for (int i = 0; avf_pixel_formats[i].ff_id != AV_PIX_FMT_NONE; i++) {
+        if (ctx->pixel_format == avf_pixel_formats[i].ff_id) {
+            pxl_fmt_spec = avf_pixel_formats[i];
+            pixelType = avf_pixel_formats[i].avf_id;
+            break;
+        }
+    }
+    if (pixelType == 0) {
+        pixelType = kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+        ctx->pixel_format = AV_PIX_FMT_NV12;
+    }
+
+    // Check if the resolved pixel format is supported by ScreenCaptureKit
+    int sck_fmt_supported = 0;
+    for (int i = 0; sck_supported_formats[i] != 0; i++) {
+        if (pixelType == sck_supported_formats[i]) {
+            sck_fmt_supported = 1;
+            break;
+        }
+    }
+
+    if (!sck_fmt_supported) {
+        av_log(s, AV_LOG_ERROR, "ScreenCaptureKit: selected pixel format (%s) is not supported.\n",
+               av_get_pix_fmt_name(ctx->pixel_format));
+        av_log(s, AV_LOG_ERROR, "ScreenCaptureKit: supported pixel formats:\n");
+
+        // List supported SCK formats that have an FFmpeg equivalent
+        struct AVFPixelFormatSpec fallback = { AV_PIX_FMT_NONE, 0 };
+        for (int i = 0; sck_supported_formats[i] != 0; i++) {
+            for (int j = 0; avf_pixel_formats[j].ff_id != AV_PIX_FMT_NONE; j++) {
+                if (sck_supported_formats[i] == avf_pixel_formats[j].avf_id) {
+                    av_log(s, AV_LOG_ERROR, "ScreenCaptureKit:   %s\n",
+                           av_get_pix_fmt_name(avf_pixel_formats[j].ff_id));
+                    if (fallback.ff_id == AV_PIX_FMT_NONE)
+                        fallback = avf_pixel_formats[j];
+                    break;
+                }
+            }
+        }
+
+        if (fallback.ff_id == AV_PIX_FMT_NONE) {
+            av_log(s, AV_LOG_ERROR, "ScreenCaptureKit: no usable pixel format found.\n");
+            [shareableContent release];
+            [filter release];
+            [config release];
+            return AVERROR(EINVAL);
+        }
+
+        pixelType = fallback.avf_id;
+        ctx->pixel_format = fallback.ff_id;
+        av_log(s, AV_LOG_WARNING, "ScreenCaptureKit: overriding pixel format to use %s instead.\n",
+               av_get_pix_fmt_name(fallback.ff_id));
+    }
+
+    config.pixelFormat = pixelType;
+
+    // 3. Audio configuration (macOS 13.0+)
+    if (ctx->capture_system_audio) {
+        if (__builtin_available(macOS 13.0, *)) {
+            config.capturesAudio = YES;
+
+            // Sample rate: 8000, 16000, 24000, 48000 (default 48000)
+            int sr = ctx->sck_audio_sample_rate;
+            if (sr != 8000 && sr != 16000 && sr != 24000 && sr != 48000)
+                sr = 48000;
+            config.sampleRate = sr;
+
+            // Channel count: 1 (mono) or 2 (stereo, default)
+            int ch = ctx->sck_audio_channels;
+            if (ch != 1 && ch != 2)
+                ch = 2;
+            config.channelCount = ch;
+
+            if (ctx->exclude_process_audio)
+                config.excludesCurrentProcessAudio = YES;
+            ctx->sck_audio_active = 1;
+            av_log(s, AV_LOG_INFO, "ScreenCaptureKit: system audio capture enabled (%dHz %s)\n",
+                   sr, ch == 1 ? "mono" : "stereo");
+        } else {
+            av_log(s, AV_LOG_WARNING,
+                   "ScreenCaptureKit: system audio requires macOS 13.0+, ignoring\n");
+        }
+    }
+
+    // 4. Create delegate + stream (delegate receives user-stop notifications)
+    ctx->sck_delegate = [[AVFSCKFrameReceiver alloc] initWithContext:ctx];
+
+    SCStream *stream = [[SCStream alloc] initWithFilter:filter configuration:config delegate:ctx->sck_delegate];
+
+    // Use separate serial queues for video and audio so that burst-y video
+    // callbacks cannot block or delay audio callbacks.
+    ctx->sck_video_queue = dispatch_queue_create("avf_sck_video", DISPATCH_QUEUE_SERIAL);
+    NSError *addError = nil;
+    [stream addStreamOutput:ctx->sck_delegate
+                       type:SCStreamOutputTypeScreen
+          sampleHandlerQueue:ctx->sck_video_queue
+                      error:&addError];
+
+    if (!addError && ctx->sck_audio_active) {
+        if (__builtin_available(macOS 13.0, *)) {
+            ctx->sck_audio_queue = dispatch_queue_create("avf_sck_audio", DISPATCH_QUEUE_SERIAL);
+            [stream addStreamOutput:ctx->sck_delegate
+                               type:SCStreamOutputTypeAudio
+                  sampleHandlerQueue:ctx->sck_audio_queue
+                              error:&addError];
+        }
+    }
+
+    [filter release];
+    [config release];
+
+    if (addError) {
+        av_log(s, AV_LOG_ERROR, "ScreenCaptureKit: failed to add stream output: %s\n",
+               [[addError localizedDescription] UTF8String]);
+        [stream release];
+        if (ctx->sck_video_queue) { dispatch_release(ctx->sck_video_queue); ctx->sck_video_queue = NULL; }
+        if (ctx->sck_audio_queue) { dispatch_release(ctx->sck_audio_queue); ctx->sck_audio_queue = NULL; }
+        [ctx->sck_delegate release];
+        ctx->sck_delegate = nil;
+        return AVERROR_EXTERNAL;
+    }
+
+    // 5. Start capture
+    int ret = avf_sck_start_capture_sync(s, stream);
+    if (ret < 0) {
+        [stream release];
+        if (ctx->sck_video_queue) { dispatch_release(ctx->sck_video_queue); ctx->sck_video_queue = NULL; }
+        if (ctx->sck_audio_queue) { dispatch_release(ctx->sck_audio_queue); ctx->sck_audio_queue = NULL; }
+        [ctx->sck_delegate release];
+        ctx->sck_delegate = nil;
+        return ret;
+    }
+
+    // 6. Store
+    ctx->sck_stream    = stream;
+    ctx->sck_active    = 1;
+    ctx->width         = captureWidth;
+    ctx->height        = captureHeight;
+    ctx->video_is_screen = 1;
+
+    if (need_windows)
+        av_log(s, AV_LOG_INFO, "ScreenCaptureKit: capturing window %d at %dx%d\n",
+               ctx->capture_window_id, captureWidth, captureHeight);
+    else
+        av_log(s, AV_LOG_INFO, "ScreenCaptureKit: capturing display %d at %dx%d\n",
+               screen_index, captureWidth, captureHeight);
+
+    return 0;
+}
+#endif
