+#if HAVE_VAAPI_DRM && !defined(_WIN32)
+static int vaapi_drm_checked = 0;
+static int vaapi_drm_available = 0;
+
+static int check_vaapi_drm_available(void *logctx)
+{
+    if (!vaapi_drm_checked) {
+        void *handle = dlopen("libva-drm.so.2", RTLD_LAZY | RTLD_LOCAL);
+        if (handle) {
+            vaapi_drm_available = (dlsym(handle, "vaGetDisplayDRM") != NULL);
+            dlclose(handle);
+        }
+        vaapi_drm_checked = 1;
+        if (!vaapi_drm_available && logctx)
+            av_log(logctx, AV_LOG_ERROR, "Cannot load libva-drm.so.2\n");
+    }
+    return vaapi_drm_available;
+}
+#endif
+
+#if HAVE_VAAPI_X11 && !defined(_WIN32)
+static int vaapi_x11_checked = 0;
+static int vaapi_x11_available = 0;
+
+static int check_vaapi_x11_available(void *logctx)
+{
+    if (!vaapi_x11_checked) {
+        void *handle = dlopen("libva-x11.so.2", RTLD_LAZY | RTLD_LOCAL);
+        if (handle) {
+            vaapi_x11_available = (dlsym(handle, "vaGetDisplay") != NULL);
+            dlclose(handle);
+        }
+        vaapi_x11_checked = 1;
+        if (!vaapi_x11_available && logctx)
+            av_log(logctx, AV_LOG_ERROR, "Cannot load libva-x11.so.2\n");
+    }
+    return vaapi_x11_available;
+}
+#endif
 
